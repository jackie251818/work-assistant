{
  "name": "work-assistant",
  "version": "1.5.3",
  "description": "工作助手 - 半透明每日待办悬浮面板（Windows / macOS）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "gen-icon": "node tools/gen-icon.js"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.trae.workassistant",
    "productName": "工作助手",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "工作助手",
      "language": "2052",
      "artifactName": "work-assistant-setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "work-assistant-${version}-mac.${ext}",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jackie251818",
        "repo": "work-assistant"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
